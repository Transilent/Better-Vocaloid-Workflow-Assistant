root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

[*.{qml,js,c,cpp,h,hpp,cmake}]
indent_size = 4
end_of_line = lf

[CMakeLists.txt]
indent_size = 4
end_of_line = lf

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.md]
end_of_line = lf
trim_trailing_whitespace = false
