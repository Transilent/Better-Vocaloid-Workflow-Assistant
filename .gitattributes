* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.onnx binary
*.gguf binary
# Frozen third-party files are hashed byte-for-byte in dependencies/manifest.json.
/dependencies/** -text
/vendor/** -text
# Preserve the legacy update-compatibility fixture's tracked CRLF bytes.
/tests/test_update_compatibility.py -text whitespace=cr-at-eol
