{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MinGW Release",
      "description": "Build VWA native audio/DSP DLLs using MinGW GCC/G++ on PATH",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/native-mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VWA_BUILD_NATIVE_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "description": "Build VWA native audio/DSP DLLs using Visual Studio / MSVC",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VWA_BUILD_NATIVE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
